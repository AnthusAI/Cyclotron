# Analyze feedback and improve the system: one optimization round, from new
# feedback to a promoted or retained classifier version.
#
# A three-column grid keeps the diagram README-width: the round runs down the
# centre, ML training sits on the left, and records and comparison labels on
# the right.
...@_cyclotron

grid-rows: 8
grid-columns: 3
horizontal-gap: 72
vertical-gap: 56

# Row 1
feedback: "New human training\nfeedback\nLabels, explanations,\nand prediction errors" {class: human}
optimizer: "LLM optimizer\nAnalyze feedback and\npropose an experiment" {class: llm}
active: "Current classifier\ndefinition\nRubric, examples, tasks,\nand fitted ML model" {class: store}

# Row 2
_r2c1: "" {class: spacer}
candidate: "Candidate request\ndefinition\nRubric · examples ·\nelement tasks" {class: llm}
transcript: "Visible optimization\nrecord\nPrompts, responses,\ntool calls, and diff" {class: store}

# Row 3
_r3c1: "" {class: spacer}
validate: "Validate proposed\nchanges\nSchema, limits, and\ndata separation" {class: step}
_r3c3: "" {class: spacer}

# Row 4
_r4c1: "" {class: spacer}
collect: "Collect candidate\nanswers\nReuse only matching\nsaved requests" {class: step}
_r4c3: "" {class: spacer}

# Row 5
fit: "Retrain custom\nML model\nFit from trusted labels;\ncalibrate out of fold" {class: ml}
features: "Convert answers\nto features\nTraining and\ndevelopment rows" {class: step}
_r5c3: "" {class: spacer}

# Row 6
_r6c1: "" {class: spacer}
evaluate: "Evaluate candidate\nvs. active\nSame development items;\napply the promotion rule" {class: step}
development: "Development labels\nFor comparison only;\nnever optimizer input\nor training" {class: human}

# Row 7
promote: "Save improved\nversion\nRubric, examples, tasks,\nfeatures, and ML model" {class: outcome}
_r7c2: "" {class: spacer}
retain: "Keep current\nclassifier\nRecord an invalid, failed,\nor weak candidate" {class: step}

# Row 8
_r8c1: "" {class: spacer}
next: "Next round\nClassify more items and\ncollect human feedback" {class: step}
_r8c3: "" {class: spacer}

feedback -> optimizer {class: proposal}
active -> optimizer {class: proposal}
optimizer -> candidate: "adjust rubric,\nexamples, tasks" {class: proposal}
optimizer -> transcript: "save\nexchange" {class: proposal}
candidate -> validate {class: flow}
validate -> collect: "valid" {class: flow}
collect -> features {class: flow}
features -> fit: "training\nrows" {class: learning}
feedback -> fit: "training labels" {class: learning}
features -> evaluate: "development rows" {class: flow}
fit -> evaluate: "candidate\nmodel" {class: learning}
development -> evaluate {class: flow}
evaluate -> promote: "pass" {class: flow}
evaluate -> retain: "fail or\nincomplete" {class: flow}
promote -> next {class: flow}
retain -> next {class: flow}

note: "Intended complete loop; current demo integration is incomplete.\nAudit and permanent holdout labels stay outside optimization.\nPer-item example retrieval is a later exploration." {
  class: note
  near: bottom-center
}
