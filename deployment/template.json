{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Transform": "AWS::Serverless-2016-10-31",
  "Description": "Reviewed Cyclotron console S3 backend; separate BFF and worker roles; live providers disabled",
  "Parameters": {
    "ConsoleIssuer": {
      "Type": "String",
      "Default": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_hlSyajw9S"
    },
    "ConsoleClientId": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9]{1,128}",
      "Description": "Dedicated reviewed console OAuth client; never directory/CRM client"
    },
    "ConsoleAuthorizationOrigin": {
      "Type": "String",
      "AllowedPattern": "https://[a-z0-9.-]+",
      "Description": "Existing central managed-login origin"
    },
    "FederationReviewId": {
      "Type": "String",
      "AllowedValues": [
        "cyclotron-google-only-unlinked-v1-20261015"
      ]
    },
    "ExecutionPairReviewId": {
      "Type": "String",
      "AllowedValues": [
        "cyclotron-execution-pair-v1-20261015"
      ]
    }
  },
  "Resources": {
    "BooksBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "cyclotron-console-books-${AWS::AccountId}-${AWS::Region}"
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "AuthBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "cyclotron-console-auth-${AWS::AccountId}-${AWS::Region}"
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "SessionEncryptionKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Cyclotron console envelope encryption; context-scoped runtime access",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        }
      }
    },
    "SessionEncryptionAlias": {
      "Type": "AWS::KMS::Alias",
      "Properties": {
        "AliasName": "alias/cyclotron-console-sessions",
        "TargetKeyId": {
          "Ref": "SessionEncryptionKey"
        }
      }
    },
    "CommandDLQ": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "cyclotron-console-commands-dlq",
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600
      }
    },
    "CommandQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": "cyclotron-console-commands",
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 1080,
        "MessageRetentionPeriod": 345600,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "CommandDLQ",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        }
      }
    },
    "BffRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "cyclotron-console-bff-runtime",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "cyclotron-console-bff",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/payloads/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/console/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/console-auth/sessions/payloads/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/console-auth/sessions/coordination/oauth/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SessionEncryptionKey",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:EncryptionContext:application": "cyclotron-console",
                      "kms:EncryptionContext:purpose": "oauth-session",
                      "kms:EncryptionContext:kind": [
                        "pending",
                        "session"
                      ]
                    },
                    "StringLike": {
                      "kms:EncryptionContext:record": "????????????????????????????????????????????????????????????????"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "execute-api:Invoke",
                  "Resource": [
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/identities/me",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/identities/google/challenge",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/identities/google/resolve",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/accounts",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/accounts",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/accounts/*",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/accounts/*/authorize"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CommandQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/cyclotron-console-bff:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BffLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/cyclotron-console-bff",
        "RetentionInDays": 14
      }
    },
    "BffFunction": {
      "Type": "AWS::Serverless::Function",
      "DependsOn": "BffLogGroup",
      "Properties": {
        "FunctionName": "cyclotron-console-bff",
        "Runtime": "python3.13",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "decision_flywheel.cloud_entry.bff_handler",
        "CodeUri": "./console-backend.zip",
        "Role": {
          "Fn::GetAtt": [
            "BffRole",
            "Arn"
          ]
        },
        "MemorySize": 1024,
        "Timeout": 28,
        "ReservedConcurrentExecutions": 5,
        "Environment": {
          "Variables": {
            "CYCLOTRON_ISSUER": {
              "Ref": "ConsoleIssuer"
            },
            "CYCLOTRON_CLIENT_ID": {
              "Ref": "ConsoleClientId"
            },
            "CYCLOTRON_AUTHORIZATION_ORIGIN": {
              "Ref": "ConsoleAuthorizationOrigin"
            },
            "CYCLOTRON_PUBLIC_ORIGIN": "https://lab.cyclotron.anth.us",
            "CYCLOTRON_ACCOUNT": {
              "Ref": "AWS::AccountId"
            },
            "CYCLOTRON_REGION": {
              "Ref": "AWS::Region"
            },
            "CYCLOTRON_BOOKS_BUCKET": {
              "Ref": "BooksBucket"
            },
            "CYCLOTRON_AUTH_BUCKET": {
              "Ref": "AuthBucket"
            },
            "CYCLOTRON_SESSION_KEY_ARN": {
              "Fn::GetAtt": [
                "SessionEncryptionKey",
                "Arn"
              ]
            },
            "CYCLOTRON_QUEUE_URL": {
              "Ref": "CommandQueue"
            }
          }
        },
        "Tags": {
          "Product": "cyclotron",
          "FederationReview": {
            "Ref": "FederationReviewId"
          },
          "ExecutionPairReview": {
            "Ref": "ExecutionPairReviewId"
          }
        },
        "Events": {
          "Root": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "ConsoleApi"
              },
              "Path": "/",
              "Method": "ANY",
              "PayloadFormatVersion": "2.0"
            }
          },
          "Proxy": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "ConsoleApi"
              },
              "Path": "/{proxy+}",
              "Method": "ANY",
              "PayloadFormatVersion": "2.0"
            }
          }
        }
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "cyclotron-console-worker-runtime",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "cyclotron-console-worker",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/payloads/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/console/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/workspace/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/runtime/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/shared-batches/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/evaluation/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/reviewer/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/optimizer/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/console-auth/sessions/payloads/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/console-auth/sessions/coordination/oauth/session-*/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SessionEncryptionKey",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "kms:EncryptionContext:application": "cyclotron-console",
                      "kms:EncryptionContext:purpose": "oauth-session",
                      "kms:EncryptionContext:kind": "session"
                    },
                    "StringLike": {
                      "kms:EncryptionContext:record": "????????????????????????????????????????????????????????????????"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "execute-api:Invoke",
                  "Resource": [
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/identities/me",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/accounts/*/authorize"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CommandQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/cyclotron-console-worker:*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/cyclotron-console-worker",
        "RetentionInDays": 14
      }
    },
    "WorkerFunction": {
      "Type": "AWS::Serverless::Function",
      "DependsOn": "WorkerLogGroup",
      "Properties": {
        "FunctionName": "cyclotron-console-worker",
        "Runtime": "python3.13",
        "Architectures": [
          "x86_64"
        ],
        "Handler": "decision_flywheel.cloud_entry.worker_handler",
        "CodeUri": "./console-backend.zip",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "MemorySize": 1024,
        "Timeout": 180,
        "ReservedConcurrentExecutions": 2,
        "Environment": {
          "Variables": {
            "CYCLOTRON_ISSUER": {
              "Ref": "ConsoleIssuer"
            },
            "CYCLOTRON_CLIENT_ID": {
              "Ref": "ConsoleClientId"
            },
            "CYCLOTRON_AUTHORIZATION_ORIGIN": {
              "Ref": "ConsoleAuthorizationOrigin"
            },
            "CYCLOTRON_PUBLIC_ORIGIN": "https://lab.cyclotron.anth.us",
            "CYCLOTRON_ACCOUNT": {
              "Ref": "AWS::AccountId"
            },
            "CYCLOTRON_REGION": {
              "Ref": "AWS::Region"
            },
            "CYCLOTRON_BOOKS_BUCKET": {
              "Ref": "BooksBucket"
            },
            "CYCLOTRON_AUTH_BUCKET": {
              "Ref": "AuthBucket"
            },
            "CYCLOTRON_SESSION_KEY_ARN": {
              "Fn::GetAtt": [
                "SessionEncryptionKey",
                "Arn"
              ]
            },
            "CYCLOTRON_QUEUE_URL": {
              "Ref": "CommandQueue"
            }
          }
        },
        "Tags": {
          "Product": "cyclotron",
          "FederationReview": {
            "Ref": "FederationReviewId"
          },
          "ExecutionPairReview": {
            "Ref": "ExecutionPairReviewId"
          }
        },
        "Events": {
          "Commands": {
            "Type": "SQS",
            "Properties": {
              "Queue": {
                "Fn::GetAtt": [
                  "CommandQueue",
                  "Arn"
                ]
              },
              "BatchSize": 1,
              "FunctionResponseTypes": [
                "ReportBatchItemFailures"
              ],
              "ScalingConfig": {
                "MaximumConcurrency": 2
              }
            }
          }
        }
      }
    },
    "BooksBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "BooksBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/payloads/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/coordination/*/*/anchor.json"
                }
              ],
              "Condition": {
                "StringNotEquals": {
                  "s3:if-none-match": "*"
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/coordination/*/*/head.json"
              },
              "Condition": {
                "Null": {
                  "s3:if-match": "true",
                  "s3:if-none-match": "true"
                }
              }
            }
          ]
        }
      }
    },
    "AuthBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AuthBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/*/payloads/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/*/coordination/*/*/anchor.json"
                }
              ],
              "Condition": {
                "StringNotEquals": {
                  "s3:if-none-match": "*"
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/*/coordination/*/*/head.json"
              },
              "Condition": {
                "Null": {
                  "s3:if-match": "true",
                  "s3:if-none-match": "true"
                }
              }
            }
          ]
        }
      }
    },
    "ConsoleApi": {
      "Type": "AWS::Serverless::HttpApi",
      "Properties": {
        "StageName": "$default",
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 10,
          "ThrottlingRateLimit": 5
        }
      }
    }
  },
  "Outputs": {
    "BackendOrigin": {
      "Value": {
        "Fn::Sub": "https://${ConsoleApi}.execute-api.${AWS::Region}.amazonaws.com"
      }
    },
    "BffRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "BffRole",
          "Arn"
        ]
      }
    },
    "WorkerRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "WorkerRole",
          "Arn"
        ]
      }
    },
    "SessionKeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "SessionEncryptionKey",
          "Arn"
        ]
      }
    },
    "BooksBucketName": {
      "Value": {
        "Ref": "BooksBucket"
      }
    },
    "AuthBucketName": {
      "Value": {
        "Ref": "AuthBucket"
      }
    },
    "CommandQueueUrl": {
      "Value": {
        "Ref": "CommandQueue"
      }
    }
  }
}
