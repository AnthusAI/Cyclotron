{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Conditions": {
    "HasLabVerifier": {
      "Fn::Equals": [
        {
          "Ref": "LabVerifierEnabled"
        },
        "true"
      ]
    },
    "HasMachineCaller": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "MachineCallerRoleArn"
            },
            ""
          ]
        }
      ]
    },
    "HasTargets": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PublicationTargets"
            },
            ""
          ]
        }
      ]
    }
  },
  "Description": "Reviewed Cyclotron console S3 backend; separate BFF and worker roles; live providers disabled",
  "Outputs": {
    "AuthBucketName": {
      "Value": {
        "Ref": "AuthBucket"
      }
    },
    "BackendOrigin": {
      "Value": {
        "Fn::Sub": "https://${ConsoleApi}.execute-api.${AWS::Region}.amazonaws.com"
      }
    },
    "BffRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "BffRole",
          "Arn"
        ]
      }
    },
    "BooksBucketName": {
      "Value": {
        "Ref": "BooksBucket"
      }
    },
    "CommandQueueUrl": {
      "Value": {
        "Ref": "CommandQueue"
      }
    },
    "MachineInvokerRoleArn": {
      "Condition": "HasMachineCaller",
      "Value": {
        "Fn::GetAtt": [
          "MachineInvokerRole",
          "Arn"
        ]
      }
    },
    "SessionKeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "SessionEncryptionKey",
          "Arn"
        ]
      }
    },
    "WorkerRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "WorkerRole",
          "Arn"
        ]
      }
    }
  },
  "Parameters": {
    "AllowLive": {
      "AllowedValues": [
        "true",
        "false"
      ],
      "Default": "false",
      "Description": "CYCLOTRON_ALLOW_LIVE",
      "Type": "String"
    },
    "ConsoleAuthorizationOrigin": {
      "AllowedPattern": "https://[a-z0-9.-]+",
      "Description": "Existing central managed-login origin",
      "Type": "String"
    },
    "ConsoleClientId": {
      "AllowedPattern": "[a-z0-9]{1,128}",
      "Description": "Dedicated reviewed console OAuth client; never directory/CRM client",
      "Type": "String"
    },
    "ConsoleIssuer": {
      "Default": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_hlSyajw9S",
      "Type": "String"
    },
    "ExecutionPairReviewId": {
      "AllowedValues": [
        "cyclotron-execution-pair-v1-20261015"
      ],
      "Type": "String"
    },
    "FederationReviewId": {
      "AllowedValues": [
        "cyclotron-google-only-unlinked-v1-20261015"
      ],
      "Type": "String"
    },
    "LabVerifierEnabled": {
      "AllowedValues": [
        "true",
        "false"
      ],
      "Default": "false",
      "Description": "When true the BFF receives CYCLOTRON_LAB_VERIFIER_ROLE_ARN and CYCLOTRON_ACCOUNTS_API_URL and curation routes verify editor tokens through the verifier role; false leaves both unset and the curation routes fail closed",
      "Type": "String"
    },
    "MachineCallerRoleArn": {
      "AllowedPattern": "^$|arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_-]{1,64}",
      "Default": "",
      "Description": "Exact IAM role ARN allowed to assume the machine invoker role; empty creates no machine access",
      "Type": "String"
    },
    "PredictionMaxRequests": {
      "AllowedPattern": "[0-9]{1,3}",
      "Default": "100",
      "Type": "String"
    },
    "PredictionModel": {
      "AllowedPattern": "[A-Za-z0-9._-]{1,64}",
      "Default": "jev-1.13.0",
      "Type": "String"
    },
    "PublicationTargets": {
      "Default": "",
      "Description": "Reviewed CYCLOTRON_PUBLICATION_TARGETS JSON; empty leaves the variable unset",
      "MaxLength": 3000,
      "Type": "String"
    }
  },
  "Resources": {
    "AuthBucket": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "BucketName": {
          "Fn::Sub": "cyclotron-console-auth-${AWS::AccountId}-${AWS::Region}"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      },
      "Type": "AWS::S3::Bucket",
      "UpdateReplacePolicy": "Retain"
    },
    "AuthBucketPolicy": {
      "Properties": {
        "Bucket": {
          "Ref": "AuthBucket"
        },
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/*"
                }
              ]
            },
            {
              "Action": "s3:PutObject",
              "Condition": {
                "StringNotEquals": {
                  "s3:if-none-match": "*"
                }
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/*/payloads/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/*/coordination/*/*/anchor.json"
                }
              ]
            },
            {
              "Action": "s3:PutObject",
              "Condition": {
                "Null": {
                  "s3:if-match": "true",
                  "s3:if-none-match": "true"
                }
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/*/coordination/*/*/head.json"
              }
            }
          ],
          "Version": "2012-10-17"
        }
      },
      "Type": "AWS::S3::BucketPolicy"
    },
    "BffFunction": {
      "DependsOn": "BffLogGroup",
      "Properties": {
        "Architectures": [
          "x86_64"
        ],
        "Code": {
          "S3Bucket": "cdk-hnb659fds-assets-682849160744-us-east-1",
          "S3Key": "cyclotron-console/backend/cb4f26885e8d85bafaaf09611bea30d3350e3bef37529e44ebbc93b3733e0758"
        },
        "Environment": {
          "Variables": {
            "CYCLOTRON_ACCOUNT": {
              "Ref": "AWS::AccountId"
            },
            "CYCLOTRON_ACCOUNTS_API_URL": {
              "Fn::If": [
                "HasLabVerifier",
                "https://bnh9mctvo9.execute-api.us-east-1.amazonaws.com/api/",
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "CYCLOTRON_ALLOW_LIVE": {
              "Ref": "AllowLive"
            },
            "CYCLOTRON_AUTHORIZATION_ORIGIN": {
              "Ref": "ConsoleAuthorizationOrigin"
            },
            "CYCLOTRON_AUTH_BUCKET": {
              "Ref": "AuthBucket"
            },
            "CYCLOTRON_BOOKS_BUCKET": {
              "Ref": "BooksBucket"
            },
            "CYCLOTRON_CENTRAL_ENDPOINT": "https://bnh9mctvo9.execute-api.us-east-1.amazonaws.com/api",
            "CYCLOTRON_CLIENT_ID": {
              "Ref": "ConsoleClientId"
            },
            "CYCLOTRON_ISSUER": {
              "Ref": "ConsoleIssuer"
            },
            "CYCLOTRON_LAB_VERIFIER_ROLE_ARN": {
              "Fn::If": [
                "HasLabVerifier",
                {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cyclotron-lab-verifier"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "CYCLOTRON_MACHINE_PRINCIPALS": {
              "Fn::If": [
                "HasMachineCaller",
                {
                  "Fn::Sub": "[\"arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cyclotron-machine-invoker\"]"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "CYCLOTRON_PREDICTION_MAX_REQUESTS": {
              "Ref": "PredictionMaxRequests"
            },
            "CYCLOTRON_PREDICTION_MODEL": {
              "Ref": "PredictionModel"
            },
            "CYCLOTRON_PUBLICATION_TARGETS": {
              "Fn::If": [
                "HasTargets",
                {
                  "Ref": "PublicationTargets"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "CYCLOTRON_PUBLIC_ORIGIN": "https://lab.cyclotron.anth.us",
            "CYCLOTRON_QUEUE_URL": {
              "Ref": "CommandQueue"
            },
            "CYCLOTRON_REGION": {
              "Ref": "AWS::Region"
            },
            "CYCLOTRON_SESSION_KEY_ARN": {
              "Fn::GetAtt": [
                "SessionEncryptionKey",
                "Arn"
              ]
            }
          }
        },
        "FunctionName": "cyclotron-console-bff",
        "Handler": "decision_flywheel.cloud_entry.bff_handler",
        "MemorySize": 1024,
        "Role": {
          "Fn::GetAtt": [
            "BffRole",
            "Arn"
          ]
        },
        "Runtime": "python3.13",
        "Tags": [
          {
            "Key": "lambda:createdBy",
            "Value": "SAM"
          },
          {
            "Key": "Product",
            "Value": "cyclotron"
          },
          {
            "Key": "FederationReview",
            "Value": {
              "Ref": "FederationReviewId"
            }
          },
          {
            "Key": "ExecutionPairReview",
            "Value": {
              "Ref": "ExecutionPairReviewId"
            }
          }
        ],
        "Timeout": 28
      },
      "Type": "AWS::Lambda::Function"
    },
    "BffFunctionMachinePermission": {
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "BffFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${__ApiId__}/${__Stage__}/*/machine/*",
            {
              "__ApiId__": {
                "Ref": "ConsoleApi"
              },
              "__Stage__": "*"
            }
          ]
        }
      },
      "Type": "AWS::Lambda::Permission"
    },
    "BffFunctionProxyPermission": {
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "BffFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${__ApiId__}/${__Stage__}/*/*",
            {
              "__ApiId__": {
                "Ref": "ConsoleApi"
              },
              "__Stage__": "*"
            }
          ]
        }
      },
      "Type": "AWS::Lambda::Permission"
    },
    "BffFunctionRootPermission": {
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "BffFunction"
        },
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": [
            "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${__ApiId__}/${__Stage__}/*/",
            {
              "__ApiId__": {
                "Ref": "ConsoleApi"
              },
              "__Stage__": "*"
            }
          ]
        }
      },
      "Type": "AWS::Lambda::Permission"
    },
    "BffLogGroup": {
      "Properties": {
        "LogGroupName": "/aws/lambda/cyclotron-console-bff",
        "RetentionInDays": 14
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "BffRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/payloads/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/console/*"
                    }
                  ]
                },
                {
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/console-auth/sessions/payloads/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${AuthBucket}/console-auth/sessions/coordination/oauth/*"
                    }
                  ]
                },
                {
                  "Action": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "Condition": {
                    "StringEquals": {
                      "kms:EncryptionContext:application": "cyclotron-console",
                      "kms:EncryptionContext:kind": [
                        "pending",
                        "session"
                      ],
                      "kms:EncryptionContext:purpose": "oauth-session"
                    },
                    "StringLike": {
                      "kms:EncryptionContext:record": "????????????????????????????????????????????????????????????????"
                    }
                  },
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": [
                      "SessionEncryptionKey",
                      "Arn"
                    ]
                  }
                },
                {
                  "Action": "execute-api:Invoke",
                  "Effect": "Allow",
                  "Resource": [
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/identities/me",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/identities/google/challenge",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/identities/google/resolve",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/accounts",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/accounts",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/accounts/*",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/accounts/*/authorize"
                  ]
                },
                {
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::GetAtt": [
                      "CommandQueue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/cyclotron-console-bff:*"
                  }
                },
                {
                  "Action": "sts:AssumeRole",
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cyclotron-lab-verifier"
                  }
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "cyclotron-console-bff"
          }
        ],
        "RoleName": "cyclotron-console-bff-runtime"
      },
      "Type": "AWS::IAM::Role"
    },
    "BooksBucket": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "BucketName": {
          "Fn::Sub": "cyclotron-console-books-${AWS::AccountId}-${AWS::Region}"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        }
      },
      "Type": "AWS::S3::Bucket",
      "UpdateReplacePolicy": "Retain"
    },
    "BooksBucketPolicy": {
      "Properties": {
        "Bucket": {
          "Ref": "BooksBucket"
        },
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*"
                }
              ]
            },
            {
              "Action": "s3:PutObject",
              "Condition": {
                "StringNotEquals": {
                  "s3:if-none-match": "*"
                }
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/payloads/*"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/coordination/*/*/anchor.json"
                }
              ]
            },
            {
              "Action": "s3:PutObject",
              "Condition": {
                "Null": {
                  "s3:if-match": "true",
                  "s3:if-none-match": "true"
                }
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/coordination/*/*/head.json"
              }
            }
          ],
          "Version": "2012-10-17"
        }
      },
      "Type": "AWS::S3::BucketPolicy"
    },
    "CommandDLQ": {
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "QueueName": "cyclotron-console-commands-dlq",
        "SqsManagedSseEnabled": true
      },
      "Type": "AWS::SQS::Queue"
    },
    "CommandQueue": {
      "Properties": {
        "MessageRetentionPeriod": 345600,
        "QueueName": "cyclotron-console-commands",
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "CommandDLQ",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        },
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 1080
      },
      "Type": "AWS::SQS::Queue"
    },
    "ConsoleApi": {
