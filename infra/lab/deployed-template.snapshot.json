    "ConsoleApiApiGatewayDefaultStage": {
      "Properties": {
        "ApiId": {
          "Ref": "ConsoleApi"
        },
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 10,
          "ThrottlingRateLimit": 5
        },
        "StageName": "$default",
        "Tags": {
          "httpapi:createdBy": "SAM"
        }
      },
      "Type": "AWS::ApiGatewayV2::Stage"
    },
    "LabVerifierRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::GetAtt": [
                    "BffRole",
                    "Arn"
                  ]
                }
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "execute-api:Invoke",
                  "Effect": "Allow",
                  "Resource": [
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/identities/me",
                    "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/accounts/*/authorize"
                  ]
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "cyclotron-lab-verify"
          }
        ],
        "RoleName": "cyclotron-lab-verifier"
      },
      "Type": "AWS::IAM::Role"
    },
    "MachineInvokerRole": {
      "Condition": "HasMachineCaller",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
