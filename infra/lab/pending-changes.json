{
  "description": "Reviewed changes the next deploy makes beyond infra/lab/deployed-template.snapshot.json. JSON Pointer add and remove operations; see pending-changes.md. Empty the list when the snapshot is refreshed after a deploy.",
  "operations": [
    {
      "op": "remove",
      "path": "/Parameters/PublicationTargets"
    },
    {
      "op": "add",
      "path": "/Parameters/StandingRuns",
      "value": {
        "Type": "String",
        "Default": "",
        "Description": "Reviewed CYCLOTRON_STANDING_RUNS JSON; empty leaves the variable unset"
      }
    },
    {
      "op": "remove",
      "path": "/Conditions/HasTargets"
    },
    {
      "op": "add",
      "path": "/Conditions/HasTargets",
      "value": {
        "Fn::Not": [
          {
            "Fn::Equals": [
              {
                "Ref": "StandingRuns"
              },
              ""
            ]
          }
        ]
      }
    },
    {
      "op": "remove",
      "path": "/Resources/BffFunction/Properties/Environment/Variables/CYCLOTRON_PUBLICATION_TARGETS"
    },
    {
      "op": "add",
      "path": "/Resources/BffFunction/Properties/Environment/Variables/CYCLOTRON_STANDING_RUNS",
      "value": {
        "Fn::If": [
          "HasTargets",
          {
            "Ref": "StandingRuns"
          },
          {
            "Ref": "AWS::NoValue"
          }
        ]
      }
    },
    {
      "op": "remove",
      "path": "/Resources/WorkerFunction/Properties/Environment/Variables/CYCLOTRON_PUBLICATION_TARGETS"
    },
    {
      "op": "add",
      "path": "/Resources/WorkerFunction/Properties/Environment/Variables/CYCLOTRON_STANDING_RUNS",
      "value": {
        "Fn::If": [
          "HasTargets",
          {
            "Ref": "StandingRuns"
          },
          {
            "Ref": "AWS::NoValue"
          }
        ]
      }
    },
    {
      "op": "add",
      "path": "/Resources/MachineInvokerRole/Properties/Policies/0/PolicyDocument/Statement/0/Resource/-",
      "value": {
        "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ConsoleApi}/$default/POST/machine/bindings/*/operations"
      }
    },
    {
      "op": "add",
      "path": "/Resources/MachineInvokerRole/Properties/Policies/0/PolicyDocument/Statement/0/Resource/-",
      "value": {
        "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${ConsoleApi}/$default/GET/machine/bindings/*/commands/*"
      }
    }
  ]
}
