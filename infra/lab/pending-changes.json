{
  "description": "Reviewed changes the next deploy makes beyond infra/lab/deployed-template.snapshot.json. Add-only JSON Pointer operations; see pending-changes.md. Empty the list when the snapshot is refreshed after a deploy.",
  "operations": [
    {
      "op": "add",
      "path": "/Parameters/LabVerifierEnabled",
      "value": {
        "Type": "String",
        "Default": "false",
        "AllowedValues": [
          "true",
          "false"
        ],
        "Description": "When true the BFF receives CYCLOTRON_LAB_VERIFIER_ROLE_ARN and CYCLOTRON_ACCOUNTS_API_URL and curation routes verify editor tokens through the verifier role; false leaves both unset and the curation routes fail closed"
      }
    },
    {
      "op": "add",
      "path": "/Conditions/HasLabVerifier",
      "value": {
        "Fn::Equals": [
          {
            "Ref": "LabVerifierEnabled"
          },
          "true"
        ]
      }
    },
    {
      "op": "add",
      "path": "/Resources/LabVerifierRole",
      "value": {
        "Type": "AWS::IAM::Role",
        "Properties": {
          "RoleName": "cyclotron-lab-verifier",
          "MaxSessionDuration": 3600,
          "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Principal": {
                  "AWS": {
                    "Fn::GetAtt": [
                      "BffRole",
                      "Arn"
                    ]
                  }
                },
                "Action": "sts:AssumeRole"
              }
            ]
          },
          "Policies": [
            {
              "PolicyName": "cyclotron-lab-verify",
              "PolicyDocument": {
                "Version": "2012-10-17",
                "Statement": [
                  {
                    "Effect": "Allow",
                    "Action": "execute-api:Invoke",
                    "Resource": [
                      "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/GET/v1/identities/me",
                      "arn:aws:execute-api:us-east-1:712236451410:bnh9mctvo9/api/POST/v1/accounts/*/authorize"
                    ]
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/BffRole/Properties/Policies/0/PolicyDocument/Statement/-",
      "value": {
        "Effect": "Allow",
        "Action": "sts:AssumeRole",
        "Resource": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cyclotron-lab-verifier"
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/BffFunction/Properties/Environment/Variables/CYCLOTRON_LAB_VERIFIER_ROLE_ARN",
      "value": {
        "Fn::If": [
          "HasLabVerifier",
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cyclotron-lab-verifier"
          },
          {
            "Ref": "AWS::NoValue"
          }
        ]
      }
    },
    {
      "op": "add",
      "path": "/Resources/BffFunction/Properties/Environment/Variables/CYCLOTRON_ACCOUNTS_API_URL",
      "value": {
        "Fn::If": [
          "HasLabVerifier",
          "https://bnh9mctvo9.execute-api.us-east-1.amazonaws.com/api/",
          {
            "Ref": "AWS::NoValue"
          }
        ]
      }
    }
  ]
}
