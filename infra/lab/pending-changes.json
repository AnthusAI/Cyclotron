{
  "description": "Reviewed changes the next deploy makes beyond infra/lab/deployed-template.snapshot.json. JSON Pointer add and remove operations; see pending-changes.md. Empty the list when the snapshot is refreshed after a deploy.",
  "operations": [
    {
      "op": "add",
      "path": "/Parameters/RetrainingSubnets",
      "value": {
        "Type": "CommaDelimitedList",
        "Description": "Public default-VPC subnets the retraining task runs in; it needs outbound internet only"
      }
    },
    {
      "op": "add",
      "path": "/Parameters/RetrainingCentralEndpoint",
      "value": {
        "Type": "String",
        "Description": "The central API the retraining task configuration names, passed at deploy; the task does not call it for its own work"
      }
    },
    {
      "op": "add",
      "path": "/Resources/RetrainingCluster",
      "value": {
        "Type": "AWS::ECS::Cluster",
        "Properties": {
          "ClusterName": "cyclotron-retraining",
          "Tags": [
            {
              "Key": "Product",
              "Value": "cyclotron"
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/RetrainingLogGroup",
      "value": {
        "Type": "AWS::Logs::LogGroup",
        "Properties": {
          "LogGroupName": "/ecs/cyclotron-retraining",
          "RetentionInDays": 14
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/RetrainingExecutionRole",
      "value": {
        "Type": "AWS::IAM::Role",
        "Properties": {
          "RoleName": "cyclotron-retraining-execution",
          "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Principal": {
                  "Service": "ecs-tasks.amazonaws.com"
                },
                "Action": "sts:AssumeRole"
              }
            ]
          },
          "Policies": [
            {
              "PolicyName": "write-logs",
              "PolicyDocument": {
                "Version": "2012-10-17",
                "Statement": [
                  {
                    "Effect": "Allow",
                    "Action": [
                      "logs:CreateLogStream",
                      "logs:PutLogEvents"
                    ],
                    "Resource": {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/ecs/cyclotron-retraining:*"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/RetrainingTaskRole",
      "value": {
        "Type": "AWS::IAM::Role",
        "Properties": {
          "RoleName": "cyclotron-retraining-task",
          "AssumeRolePolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Principal": {
                  "Service": "ecs-tasks.amazonaws.com"
                },
                "Action": "sts:AssumeRole"
              }
            ]
          },
          "Policies": [
            {
              "PolicyName": "cyclotron-retraining",
              "PolicyDocument": {
                "Version": "2012-10-17",
                "Statement": [
                  {
                    "Effect": "Allow",
                    "Action": [
                      "s3:GetObject",
                      "s3:PutObject"
                    ],
                    "Resource": [
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/payloads/*"
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/console/*"
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/optimizer/*"
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/records/*"
                      }
                    ]
                  },
                  {
                    "Effect": "Allow",
                    "Action": "s3:GetObject",
                    "Resource": [
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/workspace/*"
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-682849160744-us-east-1/cyclotron-console/backend/*"
                      },
                      {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/runtime/*"
                      }
                    ]
                  },
                  {
                    "Effect": "Allow",
                    "Action": "secretsmanager:GetSecretValue",
                    "Resource": {
                      "Fn::Sub": "arn:${AWS::Partition}:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:cyclotron/providers/openai-??????"
                    }
                  },
                  {
                    "Effect": "Allow",
                    "Action": "s3:ListBucket",
                    "Resource": {
                      "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/RetrainingTaskDefinition",
      "value": {
        "Type": "AWS::ECS::TaskDefinition",
        "Properties": {
          "Family": "cyclotron-retraining",
          "RequiresCompatibilities": [
            "FARGATE"
          ],
          "NetworkMode": "awsvpc",
          "Cpu": "1024",
          "Memory": "4096",
          "ExecutionRoleArn": {
            "Fn::GetAtt": [
              "RetrainingExecutionRole",
              "Arn"
            ]
          },
          "TaskRoleArn": {
            "Fn::GetAtt": [
              "RetrainingTaskRole",
              "Arn"
            ]
          },
          "Tags": [
            {
              "Key": "Product",
              "Value": "cyclotron"
            }
          ],
          "ContainerDefinitions": [
            {
              "Name": "retraining",
              "Image": "public.ecr.aws/lambda/python:3.13",
              "Essential": true,
              "EntryPoint": [
                "python3",
                "-c",
                "import boto3,io,os,runpy,sys,zipfile;body=boto3.client('s3').get_object(Bucket=os.environ['CYCLOTRON_PACKAGE_BUCKET'],Key=os.environ['CYCLOTRON_PACKAGE_KEY'])['Body'].read();zipfile.ZipFile(io.BytesIO(body)).extractall('/tmp/package');sys.path.insert(0,'/tmp/package');runpy.run_module('decision_flywheel.retraining',run_name='__main__')"
              ],
              "LogConfiguration": {
                "LogDriver": "awslogs",
                "Options": {
                  "awslogs-group": "/ecs/cyclotron-retraining",
                  "awslogs-region": {
                    "Ref": "AWS::Region"
                  },
                  "awslogs-stream-prefix": "retraining"
                }
              },
              "Environment": [
                {
                  "Name": "CYCLOTRON_ACCOUNT",
                  "Value": {
                    "Ref": "AWS::AccountId"
                  }
                },
                {
                  "Name": "CYCLOTRON_ALLOW_LIVE",
                  "Value": {
                    "Ref": "AllowLive"
                  }
                },
                {
                  "Name": "CYCLOTRON_AUTHORIZATION_ORIGIN",
                  "Value": {
                    "Ref": "ConsoleAuthorizationOrigin"
                  }
                },
                {
                  "Name": "CYCLOTRON_AUTH_BUCKET",
                  "Value": {
                    "Ref": "AuthBucket"
                  }
                },
                {
                  "Name": "CYCLOTRON_BOOKS_BUCKET",
                  "Value": {
                    "Ref": "BooksBucket"
                  }
                },
                {
                  "Name": "CYCLOTRON_CENTRAL_ENDPOINT",
                  "Value": {
                    "Ref": "RetrainingCentralEndpoint"
                  }
                },
                {
                  "Name": "CYCLOTRON_CLIENT_ID",
                  "Value": {
                    "Ref": "ConsoleClientId"
                  }
                },
                {
                  "Name": "CYCLOTRON_ISSUER",
                  "Value": {
                    "Ref": "ConsoleIssuer"
                  }
                },
                {
                  "Name": "CYCLOTRON_PREDICTION_MODEL",
                  "Value": {
                    "Ref": "PredictionModel"
                  }
                },
                {
                  "Name": "CYCLOTRON_PUBLIC_ORIGIN",
                  "Value": "https://lab.cyclotron.anth.us"
                },
                {
                  "Name": "CYCLOTRON_QUEUE_URL",
                  "Value": {
                    "Ref": "CommandQueue"
                  }
                },
                {
                  "Name": "CYCLOTRON_REGION",
                  "Value": {
                    "Ref": "AWS::Region"
                  }
                },
                {
                  "Name": "CYCLOTRON_SESSION_KEY_ARN",
                  "Value": {
                    "Fn::GetAtt": [
                      "SessionEncryptionKey",
                      "Arn"
                    ]
                  }
                },
                {
                  "Name": "CYCLOTRON_STANDING_RUNS",
                  "Value": {
                    "Fn::If": [
                      "HasTargets",
                      {
                        "Ref": "StandingRuns"
                      },
                      {
                        "Ref": "AWS::NoValue"
                      }
                    ]
                  }
                },
                {
                  "Name": "CYCLOTRON_PACKAGE_BUCKET",
                  "Value": "cdk-hnb659fds-assets-682849160744-us-east-1"
                },
                {
                  "Name": "CYCLOTRON_PACKAGE_KEY",
                  "Value": "cyclotron-console/backend/aa0d6b7c48bde658b77b5a718684d3dd59c419483b7860e09e4e85c8748d0808"
                },
                {
                  "Name": "CYCLOTRON_RETRAIN_ROLE_ARN",
                  "Value": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cyclotron-retraining-task"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/RetrainingCheckSchedule",
      "value": {
        "Type": "AWS::Events::Rule",
        "Properties": {
          "Description": "Every 15 minutes, look at each standing run's new votes and start retraining when they are worth it",
          "ScheduleExpression": "rate(15 minutes)",
          "State": "ENABLED",
          "Targets": [
            {
              "Id": "retraining-check",
              "Arn": {
                "Fn::GetAtt": [
                  "WorkerFunction",
                  "Arn"
                ]
              },
              "Input": "{\"operation\":\"retraining-check\"}"
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/RetrainingCheckPermission",
      "value": {
        "Type": "AWS::Lambda::Permission",
        "Properties": {
          "Action": "lambda:InvokeFunction",
          "FunctionName": {
            "Ref": "WorkerFunction"
          },
          "Principal": "events.amazonaws.com",
          "SourceArn": {
            "Fn::GetAtt": [
              "RetrainingCheckSchedule",
              "Arn"
            ]
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/WorkerRole/Properties/Policies/0/PolicyDocument/Statement/-",
      "value": {
        "Effect": "Allow",
        "Action": "ecs:RunTask",
        "Resource": {
          "Fn::Sub": "arn:${AWS::Partition}:ecs:${AWS::Region}:${AWS::AccountId}:task-definition/cyclotron-retraining:*"
        },
        "Condition": {
          "ArnEquals": {
            "ecs:cluster": {
              "Fn::GetAtt": [
                "RetrainingCluster",
                "Arn"
              ]
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/WorkerRole/Properties/Policies/0/PolicyDocument/Statement/-",
      "value": {
        "Effect": "Allow",
        "Action": "ecs:ListTasks",
        "Resource": "*",
        "Condition": {
          "ArnEquals": {
            "ecs:cluster": {
              "Fn::GetAtt": [
                "RetrainingCluster",
                "Arn"
              ]
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/WorkerRole/Properties/Policies/0/PolicyDocument/Statement/-",
      "value": {
        "Effect": "Allow",
        "Action": "iam:PassRole",
        "Resource": [
          {
            "Fn::GetAtt": [
              "RetrainingTaskRole",
              "Arn"
            ]
          },
          {
            "Fn::GetAtt": [
              "RetrainingExecutionRole",
              "Arn"
            ]
          }
        ],
        "Condition": {
          "StringEquals": {
            "iam:PassedToService": "ecs-tasks.amazonaws.com"
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/Resources/WorkerFunction/Properties/Environment/Variables/CYCLOTRON_RETRAIN_CLUSTER",
      "value": {
        "Ref": "RetrainingCluster"
      }
    },
    {
      "op": "add",
      "path": "/Resources/WorkerFunction/Properties/Environment/Variables/CYCLOTRON_RETRAIN_TASK_DEFINITION",
      "value": "cyclotron-retraining"
    },
    {
      "op": "add",
      "path": "/Resources/WorkerFunction/Properties/Environment/Variables/CYCLOTRON_RETRAIN_SUBNETS",
      "value": {
        "Fn::Join": [
          ",",
          {
            "Ref": "RetrainingSubnets"
          }
        ]
      }
    },
    {
      "op": "add",
      "path": "/Resources/WorkerFunction/Properties/Environment/Variables/CYCLOTRON_RETRAIN_ROLE_ARN",
      "value": {
        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cyclotron-retraining-task"
      }
    },
    {
      "op": "add",
      "path": "/Resources/BffRole/Properties/Policies/0/PolicyDocument/Statement/-",
      "value": {
        "Effect": "Allow",
        "Action": "s3:GetObject",
        "Resource": {
          "Fn::Sub": "arn:${AWS::Partition}:s3:::${BooksBucket}/*/console/coordination/optimizer/*"
        }
      }
    }
  ]
}
