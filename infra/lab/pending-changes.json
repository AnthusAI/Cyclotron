{
  "description": "Reviewed changes the next deploy makes beyond infra/lab/deployed-template.snapshot.json. JSON Pointer add and remove operations; see pending-changes.md. Empty the list when the snapshot is refreshed after a deploy.",
  "operations": [
    {
      "op": "add",
      "path": "/Parameters/CliBrokerArn",
      "value": {
        "Type": "String",
        "Default": "",
        "Description": "The lab's cli-login broker function ARN (stack cyclotron-cli-broker); empty leaves remote CLI sign-in off"
      }
    },
    {
      "op": "add",
      "path": "/Parameters/CliBrokerEndpoint",
      "value": {
        "Type": "String",
        "Default": "",
        "Description": "The broker's function URL, published to CLIs as remote_login_endpoint; set together with CliBrokerArn"
      }
    },
    {
      "op": "add",
      "path": "/Conditions/HasCliBroker",
      "value": {
        "Fn::Not": [
          {
            "Fn::Equals": [
              {
                "Ref": "CliBrokerArn"
              },
              ""
            ]
          }
        ]
      }
    },
    {
      "op": "add",
      "path": "/Resources/BffFunction/Properties/Environment/Variables/CYCLOTRON_CLI_BROKER_ARN",
      "value": {
        "Fn::If": [
          "HasCliBroker",
          {
            "Ref": "CliBrokerArn"
          },
          {
            "Ref": "AWS::NoValue"
          }
        ]
      }
    },
    {
      "op": "add",
      "path": "/Resources/BffFunction/Properties/Environment/Variables/CYCLOTRON_CLI_BROKER_ENDPOINT",
      "value": {
        "Fn::If": [
          "HasCliBroker",
          {
            "Ref": "CliBrokerEndpoint"
          },
          {
            "Ref": "AWS::NoValue"
          }
        ]
      }
    },
    {
      "op": "add",
      "path": "/Resources/BffRole/Properties/Policies/0/PolicyDocument/Statement/-",
      "value": {
        "Fn::If": [
          "HasCliBroker",
          {
            "Effect": "Allow",
            "Action": [
              "lambda:InvokeFunction"
            ],
            "Resource": [
              {
                "Ref": "CliBrokerArn"
              }
            ]
          },
          {
            "Ref": "AWS::NoValue"
          }
        ]
      }
    }
  ]
}
